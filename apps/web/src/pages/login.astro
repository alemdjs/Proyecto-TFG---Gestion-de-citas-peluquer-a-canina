---
import Base from "../layouts/Base.astro";
const next = Astro.url.searchParams.get("next") ?? "/panel";
---

<Base title="Entrar · Peluditos">
  <div class="card" style="max-width:440px;margin:auto">
    <h1 style="font-size:1.6rem">Entrar</h1>
    <form id="f">
      <label for="email">Correo</label>
      <input id="email" type="email" required autocomplete="email" />
      <label for="password">Contraseña</label>
      <input id="password" type="password" required autocomplete="current-password" />
      <p id="msg" class="err"></p>
      <button class="btn" style="width:100%;margin-top:1rem">Entrar</button>
    </form>
    <p class="small" style="margin:1rem 0 0">¿Sin cuenta? <a href="/register">Regístrate</a></p>
    <div class="card" style="margin-top:1rem;background:var(--mu)">
      <p class="small" style="margin:0 0 .5em"><strong>Cuentas demo</strong> (tras `bun run db:seed`)</p>
      <ul class="small mut" style="margin:0;padding-left:1.1rem">
        <li>Admin: <code>admin@peluditos.local</code> / <code>admin123</code></li>
        <li>Peluquera: <code>lucia@peluditos.local</code> / <code>groomer123</code></li>
        <li>Cliente: regístrate tú mismo</li>
      </ul>
    </div>
  </div>
  <script define:vars={{ apiUrl: import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000", next }}>
    document.getElementById("f").addEventListener("submit", async (e) => {
      e.preventDefault();
      const res = await fetch(`${apiUrl}/api/v1/auth/login`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: document.getElementById("email").value,
          password: document.getElementById("password").value,
        }),
      });
      const json = await res.json();
      if (!json.success) { document.getElementById("msg").textContent = json.error; return; }
      window.location.href = next;
    });
  </script>
</Base>
