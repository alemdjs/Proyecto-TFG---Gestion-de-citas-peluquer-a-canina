---
import "../styles/global.css";
import { API_URL, apiGet } from "../lib/api";

interface Props {
  title?: string;
  section?: string;
}
const { title = "Peluditos, peluquería canina", section = "" } = Astro.props;

// Estado de sesión para el nav (SSR en cada petición; null = anónimo).
let me: { name: string; email: string; role: string } | null = null;
try {
  const cookie = Astro.request.headers.get("cookie") ?? "";
  if (cookie) me = (await apiGet("/api/v1/auth/me", cookie)) as typeof me;
} catch {
  me = null;
}

const ROLE_SECTIONS: Record<string, { href: string; label: string }[]> = {
  client: [
    { href: "/panel", label: "Panel" },
    { href: "/reservar", label: "Reservar" },
    { href: "/mis-mascotas", label: "Mis mascotas" },
    { href: "/mis-citas", label: "Mis citas" },
  ],
  groomer: [
    { href: "/panel", label: "Panel" },
    { href: "/agenda", label: "Agenda" },
  ],
  admin: [
    { href: "/panel", label: "Panel" },
    { href: "/admin", label: "Admin" },
  ],
};
const sub = me ? (ROLE_SECTIONS[me.role] ?? []) : [];
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta
      name="description"
      content="Peluquería canina Peluditos: baño, corte y cuidado. Reserva tu cita online."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#app">Saltar al contenido</a>
    <header class="top">
      <div class="wrap">
        <div class="bar">
          <a class="logo" href="/" aria-label="Peluditos, inicio">
            <i>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <ellipse cx="5" cy="11" rx="2.2" ry="2.8"/><ellipse cx="9.5" cy="6" rx="2.2" ry="2.8"/><ellipse cx="14.5" cy="6" rx="2.2" ry="2.8"/><ellipse cx="19" cy="11" rx="2.2" ry="2.8"/><path d="M12 12c-3 0-6 3.4-6 6 0 2 1.8 2.6 3.2 2.2 1.1-.3 1.8-.6 2.8-.6s1.7.3 2.8.6c1.4.4 3.2-.2 3.2-2.2 0-2.6-3-6-6-6z"/>
              </svg>
            </i>Peluditos
          </a>
          <nav class="nav" aria-label="Principal">
            {me ? (
              <>
                <a class="btn gh sm" href="/panel">Panel</a>
                <button class="btn sec sm" id="logout" type="button">Salir</button>
              </>
            ) : (
              <>
                <a class="btn gh sm" href="/reservar">Reservar</a>
                <a class="btn sm" href="/login">Entrar</a>
              </>
            )}
          </nav>
        </div>
        {me && sub.length > 0 && (
          <nav class="sub" aria-label="Secciones">
            {sub.map((s) => (
              <a
                class="btn gh sm"
                aria-current={here === s.href || (s.href !== "/panel" && here.startsWith(s.href)) ? "page" : undefined}
                href={s.href}
              >{s.label}</a>
            ))}
          </nav>
        )}
      </div>
    </header>
    <main><div class="wrap" id="app" tabindex="-1"><slot /></div></main>
    <footer>
      <div class="wrap row" style="align-items:flex-start">
        <div>
          <strong>Peluditos, peluquería canina</strong>
          <p class="mut small" style="margin:0">Calle de los Olmos 12, Madrid · 910 000 000</p>
        </div>
        <div>
          <strong>Horario</strong>
          <p class="mut small" style="margin:0">Lunes a sábado, 10:00–19:00<br />Domingos cerrado</p>
        </div>
      </div>
    </footer>
    <div id="toast" role="status" aria-live="polite"></div>
    <script define:vars={{ apiUrl: API_URL }}>
      window.toast = (m) => {
        const t = document.getElementById("toast");
        t.innerHTML = `<div class="toast">${m}</div>`;
        clearTimeout(window.toast.t);
        window.toast.t = setTimeout(() => (t.innerHTML = ""), 3500);
      };
      document.getElementById("logout")?.addEventListener("click", async () => {
        try {
          await fetch(`${apiUrl}/api/v1/auth/logout`, { method: "POST", credentials: "include" });
        } catch { /* aunque falle, volvemos a la landing como anónimo */ }
        window.location.href = "/";
      });
    </script>
  </body>
</html>
